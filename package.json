{
  "name": "vektor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "sh -c 'case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm\" >&2; exit 1 ;; esac'",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
